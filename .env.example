# Oracle Admin Credentials (for setup only)
# These are used by setup/setup_database.py to create tables and the agent user
ORACLE_USERNAME=ADMIN
ORACLE_PASSWORD=your_admin_password_here
ORACLE_CONNECTION_STRING=moviedb_high
ORACLE_WALLET_LOCATION=./wallet
ORACLE_WALLET_PASSWORD=your_wallet_password_here

# Oracle Agent Credentials (for runtime)
# Least-privilege user created by setup - has SELECT-only access to a view
# Choose your own username/password; setup will create this user automatically
ORACLE_AGENT_USERNAME=movie_agent

# Password must meet Oracle policy: 12+ chars, 1+ uppercase, 1+ lowercase, 1+ digit
# Example: MovieAgent_2024
ORACLE_AGENT_PASSWORD=your_agent_password_here

# Anthropic API Key (required for LLM calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
